<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DiagnosticExplorer.Log4Net</AssemblyName>
    <RootNamespace>DiagnosticExplorer.Log4Net</RootNamespace>
    <IsDiagnosticExplorerPackage>true</IsDiagnosticExplorerPackage>
    <Version>$(DiagnosticExplorerPackageVersion)</Version>
    <AssemblyVersion>$(DiagnosticExplorerAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(DiagnosticExplorerFileVersion)</FileVersion>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>log4net appenders and integration for DiagnosticExplorer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiagnosticExplorer\DiagnosticExplorer.csproj" />
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

</Project>