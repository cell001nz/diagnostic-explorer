<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WidgetSampleNuget</AssemblyName>
    <RootNamespace>WidgetSampleNuget</RootNamespace>
    <StartupObject>WidgetSampleNuget.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiagnosticExplorer" Version="5.0.4" />
    <PackageReference Include="DiagnosticExplorer.Extensions.Logging" Version="5.0.4" />
    <PackageReference Include="DiagnosticExplorer.Hosting" Version="5.0.4" />
    <PackageReference Include="DiagnosticExplorer.SelfHost" Version="5.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
