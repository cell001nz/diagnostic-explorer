{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Development",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\BuildDev.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build NuGet Packages",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\Build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish NuGet Packages",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\Publish-NuGetPackages.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build NuGet Packages",
      "dependsOrder": "sequence"
    }
  ]
}
