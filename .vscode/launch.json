      "cwd": "${workspaceFolder}/samples/WidgetSample.Net10.NLog",
      "preLaunchTask": "Build WidgetSample.Net10.NLog",
      "stopAtEntry": false
    },
    {
      "name": "Debug Widget Sample Serilog",
      "type": "coreclr",
